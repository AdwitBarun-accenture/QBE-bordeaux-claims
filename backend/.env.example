# ======================================================================
# Copy to .env for local development.  On Azure these become Container
# App environment variables / Key Vault secret references.
# ======================================================================
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=please-change-me-to-a-long-random-string
SEED_DEMO_USERS=true

# --- databases ---
DATABASE_URL=sqlite:///./bdx_local.db
DWH_DATABASE_URL=sqlite:///./bdx_dwh.db
# Azure example:
# DATABASE_URL=postgresql+psycopg://bdxadmin:<pw>@<server>.postgres.database.azure.com:5432/bdx?sslmode=require
# DWH_DATABASE_URL=postgresql+psycopg://bdxadmin:<pw>@<server>.postgres.database.azure.com:5432/bdx_dwh?sslmode=require
DWH_LOADER=sql

# --- storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data
# STORAGE_BACKEND=azure_blob
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net

# --- AI provider: none | anthropic | anthropic_foundry | azure_openai ---
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
# Claude on Microsoft Foundry (Azure):
# LLM_PROVIDER=anthropic_foundry
# ANTHROPIC_FOUNDRY_RESOURCE=<your-foundry-resource-name>
# ANTHROPIC_FOUNDRY_API_KEY=<key from deployment Details tab>
# ANTHROPIC_FOUNDRY_USE_ENTRA=false
# LLM_MODEL=<your deployment name>
# Direct Claude API:
# ANTHROPIC_API_KEY=sk-ant-...

# --- queue: inprocess | sync | servicebus ---
QUEUE_BACKEND=inprocess

# --- secrets ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOCAL_VAULT_KEY=
# KEY_VAULT_URL=https://<vault>.vault.azure.net/

# --- connectors (optional) ---
ENABLE_SCHEDULER=false
POLL_MINUTES=15
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAILBOX=bordereaux@yourcompany.com
# SFTP_HOST=
# SFTP_USERNAME=
# SFTP_PASSWORD=
# SFTP_WATCH_DIR=/inbound/bordereaux
